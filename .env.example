# Copiez ce fichier en « .env.local » et remplissez les valeurs.
# Sur Netlify, ces mêmes variables se règlent dans :
# Project configuration > Environment variables.

# Identifiant du projet Sanity (sanity.io/manage > votre projet, en haut : « Project ID »).
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Nom du jeu de données Sanity.
NEXT_PUBLIC_SANITY_DATASET=production

# Mot de passe partagé entre Sanity (webhook) et le site, pour vider le cache à
# chaque publication. Une longue suite de caractères au hasard. SECRET : ne jamais
# le publier ni l'envoyer par message.
SANITY_REVALIDATE_SECRET=

# --- Brevo : e-mails des formulaires, contacts et newsletter --------------------
# Clé API Brevo (SECRET). Droits : « Transactional emails » + « Contacts ».
# Expire après 90 jours sans usage (évité par la tâche hebdomadaire) et au plus
# tard à la date indiquée dans BREVO_KEY_EXPIRES. Voir README « Renouveler la clé Brevo ».
BREVO_API_KEY=
# Date d'expiration de la clé (alerte 30 jours avant). Format AAAA-MM-JJ.
BREVO_KEY_EXPIRES=2027-11-18
# Expéditeur (doit être validé dans Brevo). Valeurs par défaut ci-dessous.
BREVO_SENDER_EMAIL=contact@champagnedelaube.fr
BREVO_SENDER_NAME=Champagne de l'Aube
# Adresse qui reçoit les alertes de la tâche hebdomadaire (par défaut : contact@).
ALERT_EMAIL=
# Signature des liens de confirmation de la newsletter (SECRET) : une longue suite
# de caractères au hasard. Recommandé : sans elle, la clé Brevo est utilisée, et
# les liens en cours deviennent invalides le jour où la clé est renouvelée.
NEWSLETTER_SECRET=

# --- Anti-spam Cloudflare Turnstile (facultatif mais recommandé) ---------------
# Clé du site (publique) et clé secrète (SECRET) : dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
