     {
      "_key": "2e6xbmwfd5t2",
      "_type": "span",
      "marks": [],
      "text": "Each style of "
     },
     {
      "_key": "4eksg2npjdgp",
      "_type": "span",
      "marks": [
       "strong"
      ],
      "text": "champagne"
     },
     {
      "_key": "kd6t1xgauceb",
