     {
      "_key": "7a6bf77579b5",
      "_type": "span",
      "marks": [
       "strong"
      ],
      "text": "Mise en valeur mutuelle"
     },
     {
      "_key": "4f6a3d4605d6",
      "_type": "span",
      "marks": [],
      "text": " : un accord réussi magnifie à la fois le plat et le champagne."
     }
    ],
    "level": 1,
    "listItem": "bullet",
