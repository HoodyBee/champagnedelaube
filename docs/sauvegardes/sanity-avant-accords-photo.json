      "_type": "span",
      "marks": [
       "pdjmq2ojfa7p"
      ],
      "text": " its grapes,"
     },
     {
      "_key": "1w7wiuhy31yz",
      "_type": "span",
      "marks": [],
      "text": " which determines the dishes it pairs best with. For example:"
     }
    ],
    "markDefs": [
     {
