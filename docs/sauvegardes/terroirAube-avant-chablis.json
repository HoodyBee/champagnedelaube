  "cepagesTextes": [
    {
      "_key": "ti4",
      "_type": "cepageTexte",
      "cepage": "pinot-noir",
      "texte": {
        "_type": "localeText",
        "en": "The leading grape of the appellation. In a blend, it gives champagne its structure: its backbone and body.",
        "fr": "Le premier cépage de l'appellation. Dans l'assemblage, il donne au champagne sa structure : sa charpente et son ampleur.",
        "it": "Il primo vitigno della denominazione. Nell'assemblaggio dà allo champagne struttura: ossatura e ampiezza.",
        "nl": "Het belangrijkste ras van de appellatie. In een assemblage geeft het de champagne structuur: ruggengraat en volume."
      }
    },
    {
      "_key": "ti5",
      "_type": "cepageTexte",
      "cepage": "chardonnay",
      "texte": {
        "_type": "localeText",
        "en": "Champagne's great white grape. In a blend, it brings finesse and freshness; on its own, it makes blanc de blancs.",
        "fr": "Le grand cépage blanc de la Champagne. Dans l'assemblage, il apporte la finesse et la fraîcheur ; seul, il donne les blancs de blancs.",
        "it": "Il grande vitigno bianco della Champagne. Nell'assemblaggio porta finezza e freschezza; da solo dà i blanc de blancs.",
        "nl": "De grote witte druif van de Champagne. In een assemblage brengt hij finesse en frisheid; alleen maakt hij blanc de blancs."
      }
    },
    {
      "_key": "ti6",
      "_type": "cepageTexte",
      "cepage": "meunier",
      "texte": {
        "_type": "localeText",
        "en": "The third great Champagne grape. In a blend, it brings roundness and fruit, and gives the wine suppleness.",
        "fr": "Le troisième grand cépage champenois. Dans l'assemblage, il apporte la rondeur et le fruit, et donne de la souplesse au vin.",
        "it": "Il terzo grande vitigno champenois. Nell'assemblaggio porta rotondità e frutto, e rende il vino morbido.",
        "nl": "Het derde grote champagneras. In een assemblage brengt hij rondheid en fruit, en maakt hij de wijn soepel."
      }
    }
  ],
  "cepagesTitre": {
