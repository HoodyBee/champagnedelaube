    "markDefs": [],
    "style": "normal"
   },
   {
    "_key": "d446ae2033dd",
    "_type": "block",
    "children": [
     {
      "_key": "7f8f8825f581",
      "_type": "span",
      "marks": [],
      "text": "Après avoir développé la "
     },
     {
      "_key": "afdbfdd50850",
      "_type": "span",
      "marks": [
       "426617c78e62"
      ],
      "text": "page Instagram Champagne de l’Aube"
     },
     {
      "_key": "65b0ae2e8d43",
      "_type": "span",
      "marks": [],
      "text": " et fédéré une communauté d’amateurs autour des vignerons et des pépites de notre territoire, nous souhaitons aujourd’hui aller plus loin."
     }
    ],
    "markDefs": [
     {
      "_key": "426617c78e62",
      "_type": "link",
      "href": "https://www.instagram.com/champagnedelaube/"
     }
    ],
    "style": "normal"
   },
   {
