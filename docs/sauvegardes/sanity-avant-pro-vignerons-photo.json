     {
      "_key": "ze1ottkj7k8a",
      "_type": "span",
      "marks": [],
      "text": "Our approach is simple: "
     },
     {
      "_key": "s426rtaigf0p",
      "_type": "span",
      "marks": [
       "strong"
      ],
      "text": "to build bridges between Aube winemakers and new audiences"
     },
     {
      "_key": "hbim9l5nutyz",
      "_type": "span",
      "marks": [],
      "text": ", drawing on our knowledge of the area, the people we meet in the field and the relationships we build with professionals."
