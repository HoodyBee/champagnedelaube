    "_type": "block",
    "children": [
     {
      "_key": "k8rwlzbvjz6c",
      "_type": "span",
      "marks": [],
      "text": "We favour estates that share our vision: "
     },
     {
      "_key": "zi382zl1f73e",
      "_type": "span",
      "marks": [
       "strong"
      ],
      "text": "authenticity, know-how, terroir and closeness."
