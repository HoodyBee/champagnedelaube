    "_type": "block",
    "children": [
     {
      "_key": "n47mitd0wp2g",
      "_type": "span",
      "marks": [
       "strong"
      ],
      "text": "You put your energy into making cuvées with character, true reflections of the Aube terroirs. Our role is to introduce your work to people who will appreciate it."
     }
    ],
    "markDefs": [],
    "style": "normal"
   },
   {
    "_key": "nfcrb17tr3g1",
    "_type": "block",
    "children": [
     {
      "_key": "eiaad0boc5y9",
      "_type": "span",
      "marks": [],
      "text": "After building the "
     },
     {
      "_key": "ex445wrvloxo",
      "_type": "span",
      "marks": [
       "0a1eqeoxk9hr"
      ],
      "text": "Champagne de l'Aube Instagram page"
     },
     {
      "_key": "6ot5olvibvbu",
      "_type": "span",
      "marks": [],
      "text": " and bringing together a community of enthusiasts around the winemakers and gems of our area, we now want to go further."
