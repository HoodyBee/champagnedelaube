  "accroche": {
    "_type": "localeString",
    "en": "A chalk hill on the edge of Troyes, nicknamed the \"Montrachet of Champagne\".",
    "fr": "Une colline de craie aux portes de Troyes, que l'on surnomme le « Montrachet de la Champagne ».",
    "it": "Una collina di gesso alle porte di Troyes, soprannominata il \"Montrachet della Champagne\".",
    "nl": "Een krijtheuvel aan de rand van Troyes, bijgenaamd de \"Montrachet van de Champagne\"."
  },
  "cepagesDominants": [
