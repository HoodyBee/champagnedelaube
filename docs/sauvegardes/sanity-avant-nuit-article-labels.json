     {
      "_key": "guj2ih0t5etn",
      "_type": "span",
      "marks": [],
      "text": "Whether through organic farming, HVE or sustainable viticulture, these labels help consumers "
     },
     {
      "_key": "18pz4shhmpgj",
      "_type": "span",
      "marks": [
       "strong"
      ],
      "text": "better understand winemakers' practices"
