      "_type": "span",
      "marks": [],
      "text": "."
     }
    ],
    "markDefs": [],
    "style": "normal"
   }
  ],
  "fr": [
   {
    "_key": "15794f6c86c2",
    "_type": "block",
    "children": [
     {
      "_key": "0dd7b1db320f",
      "_type": "span",
      "marks": [],
      "text": "Nos vignerons s’engagent de plus en plus pour la planète. Mais entre le Bio, le HVE, la biodynamie ou le VDC, il est facile de s’y perdre. Ce guide, conçu en collaboration avec "
     },
     {
      "_key": "b04c446d83ec",
      "_type": "span",
      "marks": [
       "strong",
       "4e5147d5a5d4"
      ],
      "text": "notre agence de communication partenaire"
     },
     {
      "_key": "34cd8280b93e",
      "_type": "span",
      "marks": [],
      "text": ", décrypte pour vous les étiquettes pour vous aider à choisir votre prochaine cuvée en toute conscience."
     }
    ],
    "markDefs": [
     {
      "_key": "4e5147d5a5d4",
      "_type": "link",
      "href": "https://www.detectezmoi.com/"
     }
    ],
    "style": "normal"
   },
   {
    "_key": "a940720d64fa",
    "_type": "block",
    "children": [
     {
      "_key": "950aa24e60ea",
      "_type": "span",
      "marks": [],
      "text": "Le comparatif rapide : Quel label garantit quoi ?"
     }
    ],
    "markDefs": [],
    "style": "h2"
   },
   {
    "_key": "6766d0669e04",
    "_type": "block",
    "children": [
     {
      "_key": "18f58c3460b7",
      "_type": "span",
      "marks": [],
      "text": "Pour comprendre un label en un coup d’œil"
     }
    ],
    "markDefs": [],
    "style": "normal"
   },
   {
    "_key": "tableaulabelsfr",
