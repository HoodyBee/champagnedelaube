    "_type": "block",
    "children": [
     {
      "_key": "pbqj7t57uk46",
      "_type": "span",
      "marks": [],
      "text": "La traçabilité : chaque geste du vigneron est consigné. S’il utilise un traitement de synthèse, il doit pouvoir le justifier."
     }
    ],
    "markDefs": [],
    "style": "normal"
   },
   {
