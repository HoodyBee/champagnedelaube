                "strong"
              ],
              "text": "Sol"
            },
            {
              "_key": "4400490e4deb",
              "_type": "span",
              "marks": [],
              "text": " : Sols argilo-calcaires, adaptés au Chardonnay."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "0a820fc696e1",
