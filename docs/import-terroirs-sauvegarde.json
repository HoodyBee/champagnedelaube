        {
          "_key": "977b425ea577",
          "_type": "block",
          "children": [
            {
              "_key": "0a0939b8730f",
              "_type": "span",
              "marks": [],
              "text": "Les zones emblématiques de la Côte des Bar : Barséquanais, Barsuraubois et Les Riceys"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "2228aa135feb",
          "_type": "block",
          "children": [
            {
              "_key": "87f88c847c23",
              "_type": "span",
              "marks": [
                "57746e91dc25"
              ],
              "text": "Le Barséquanais"
            }
          ],
          "markDefs": [
            {
              "_key": "57746e91dc25",
              "_type": "link",
              "href": "/category/la-cote-des-bar/le-barsequanais/"
            }
          ],
          "style": "h3"
        },
        {
          "_key": "7a411197e719",
          "_type": "block",
          "children": [
            {
              "_key": "b3579815707f",
              "_type": "span",
              "marks": [],
              "text": "Le Barséquanais s’étend autour de Bar-sur-Seine. Ce terroir vallonné, composé principalement de marnes et de calcaires kimméridgiens, est dominé par le Pinot Noir."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "ef5639397e1c",
          "_type": "block",
          "children": [
            {
              "_key": "638a650d2cf7",
              "_type": "span",
