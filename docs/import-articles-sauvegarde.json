              "marks": [],
              "text": " est à un plat : il en définit la base et influence son "
            },
            {
              "_key": "2b7f767ee008",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "caractère"
            },
            {
              "_key": "7a5b809219a8",
              "_type": "span",
              "marks": [],
              "text": ". Le "
