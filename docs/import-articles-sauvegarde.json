          "_type": "block",
          "children": [
            {
              "_key": "ad9b0fcbe138",
              "_type": "span",
              "marks": [],
              "text": "Goût et arômes : fruité, floral, minéral…"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
