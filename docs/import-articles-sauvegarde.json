          "_type": "block",
          "children": [
            {
              "_key": "6aea7d9c24b2",
              "_type": "span",
              "marks": [],
              "text": "Une comparaison gourmande"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "789d89ddced9",
          "_type": "block",
          "children": [
            {
              "_key": "e19022ac4fec",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "On peut comparer les cépages aux variétés de pommes "
            },
            {
              "_key": "a35d63bfae95",
              "_type": "span",
              "marks": [],
              "text": ": toutes sont des pommes, mais une Golden et une Granny Smith n’ont ni la même couleur, ni la même acidité, ni le même parfum. De la même façon, chaque cépage de champagne a son caractère unique."
            }
