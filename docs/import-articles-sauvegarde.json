            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "f581559b383a",
          "_type": "block",
          "children": [
            {
              "_key": "7dc8ff2a9fc6",
              "_type": "span",
              "marks": [],
              "text": "Pourquoi connaître les cépages ?"
