              "marks": [
                "strong"
              ],
              "text": "cépage"
            },
            {
              "_key": "818b0bd86f77",
              "_type": "span",
              "marks": [],
              "text": " est une variété spécifique de vigne cultivée pour produire du raisin destiné à la vinification. Chaque cépage possède ses propres caractéristiques :"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
