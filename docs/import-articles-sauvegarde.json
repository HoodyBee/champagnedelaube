            {
              "_key": "bea7dca8a5ec",
              "_type": "span",
              "marks": [],
              "text": "Couleur de la peau : blanc ou noir."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "f7211145b715",
          "_type": "block",
          "children": [
            {
              "_key": "1788a59b1898",
              "_type": "span",
              "marks": [],
              "text": "Structure : acidité, rondeur, tanins..."
